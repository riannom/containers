<!doctype html>
<!--
  Shared by all three Electrs apps (keep the copies identical). umbrelOS
  renders *.template files with envsubst on install and update, so this file
  must not contain a dollar sign. Network-specific values come from
  /config.json in nginx.conf.template.
-->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Electrs</title>
<style>
  :root {
    --bg1: #16161c; --bg2: #0b0b0f; --accent: #a1a1aa; --soft: #e4e4e7;
    --text: #ececf1; --muted: #9a9aa6; --card: rgba(255,255,255,0.045);
    --line: rgba(255,255,255,0.08); --ok: #4ade80; --warn: #fbbf24; --err: #f87171;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  html { background: var(--bg2); }
  body {
    min-height: 100vh; color: var(--text);
    background: radial-gradient(1200px 600px at 15% -10%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%),
                linear-gradient(160deg, var(--bg1), var(--bg2) 70%);
    background-attachment: fixed;
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", system-ui, sans-serif;
  }
  main { max-width: 980px; margin: 0 auto; padding: 32px 16px 48px; }
  header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; }
  header svg { width: 48px; height: 48px; border-radius: 12px; flex: none; }
  h1 { font-size: 22px; margin: 0; font-weight: 650; letter-spacing: -0.01em; }
  .sub { color: var(--muted); font-size: 13px; }
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px;
          font-size: 12px; font-weight: 600; letter-spacing: 0.04em; background: var(--card); border: 1px solid var(--line); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
  .tone-ok .dot { background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 20%, transparent); }
  .tone-busy .dot { background: var(--accent); animation: pulse 1.6s ease-in-out infinite; }
  .tone-warn .dot { background: var(--warn); }
  .tone-err .dot { background: var(--err); }
  @keyframes pulse { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .tone-busy .dot { animation: none; } #bar > i { transition: none; } }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 20px; }
  .hero { margin-bottom: 16px; }
  .hero h2 { font-size: 26px; margin: 10px 0 4px; font-weight: 650; letter-spacing: -0.02em; }
  .hero p { margin: 0; color: var(--muted); }
  #bar { height: 8px; border-radius: 99px; background: rgba(255,255,255,0.07); overflow: hidden; margin: 18px 0 10px; }
  #bar > i { display: block; height: 100%; width: 0; border-radius: inherit;
             background: linear-gradient(90deg, var(--soft), var(--accent)); transition: width 0.8s ease; }
  .row { display: flex; flex-wrap: wrap; gap: 6px 22px; color: var(--muted); font-size: 13px; }
  .row b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .stat .k { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; }
  .stat .v { font-size: 22px; font-weight: 650; margin-top: 4px; font-variant-numeric: tabular-nums; }
  .stat .n { color: var(--muted); font-size: 12px; margin-top: 2px; }
  .cols { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; } }
  h3 { margin: 0 0 12px; font-size: 14px; font-weight: 650; color: var(--soft); letter-spacing: 0.02em; }
  #spark { width: 100%; height: 64px; display: block; margin-bottom: 16px; }
  #feed { list-style: none; margin: 0; padding: 0; max-height: 360px; overflow: auto; }
  #feed li { display: grid; grid-template-columns: 64px 1fr; gap: 10px; padding: 8px 0; border-top: 1px solid var(--line); font-size: 13px; }
  #feed li:first-child { border-top: 0; }
  #feed time { color: var(--muted); font-variant-numeric: tabular-nums; }
  .empty { color: var(--muted); font-size: 13px; }
  #feed li.empty { display: block; }
  .field { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px;
           border-radius: 10px; background: rgba(0,0,0,0.25); border: 1px solid var(--line); margin-bottom: 8px; }
  .field span { color: var(--muted); font-size: 12px; }
  .field code { font: 600 14px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--text); word-break: break-all; }
  button { font: inherit; font-size: 12px; color: var(--text); background: rgba(255,255,255,0.08); border: 1px solid var(--line);
           border-radius: 8px; padding: 4px 10px; cursor: pointer; flex: none; }
  button:hover { background: rgba(255,255,255,0.14); }
  ol { margin: 12px 0 0; padding-left: 18px; color: var(--muted); font-size: 13px; }
  ol li { margin-bottom: 6px; }
  ol b { color: var(--text); font-weight: 600; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  td { padding: 6px 0; border-top: 1px solid var(--line); }
  td:last-child { text-align: right; font-variant-numeric: tabular-nums; }
  footer { margin-top: 20px; color: var(--muted); font-size: 12px; text-align: center; }
</style>
</head>
<body>
<main>
  <header>
    <span id="mark"></span>
    <div>
      <h1 id="title">Electrs</h1>
      <div class="sub" id="subtitle">Personal Electrum server</div>
    </div>
  </header>

  <section class="card hero" aria-live="polite">
    <span class="pill" id="pill"><span class="dot"></span><span id="pillText">Connecting</span></span>
    <h2 id="headline">Checking status…</h2>
    <p id="detail"></p>
    <div id="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"><i></i></div>
    <div class="row">
      <span>Indexed <b id="rIndexed">–</b></span>
      <span>Node tip <b id="rTip">–</b></span>
      <span>Speed <b id="rRate">–</b></span>
      <span>Time left <b id="rEta">–</b></span>
    </div>
  </section>

  <section class="grid">
    <div class="card stat"><div class="k">Transactions indexed</div><div class="v" id="sTx">–</div><div class="n">estimate</div></div>
    <div class="card stat"><div class="k">Index size</div><div class="v" id="sDb">–</div><div class="n">on disk</div></div>
    <div class="card stat"><div class="k">Block data read</div><div class="v" id="sBlocks">–</div><div class="n" id="sBlocksN">from the node</div></div>
    <div class="card stat"><div class="k">Node peers</div><div class="v" id="sPeers">–</div><div class="n" id="sMempool">mempool –</div></div>
  </section>

  <div class="cols">
    <section class="card">
      <h3>Activity</h3>
      <svg id="spark" viewBox="0 0 300 64" preserveAspectRatio="none" aria-label="Indexing speed over the last few minutes"></svg>
      <ul id="feed"><li class="empty">Waiting for the first update…</li></ul>
    </section>

    <div>
      <section class="card" style="margin-bottom:16px">
        <h3>Connect a wallet</h3>
        <div class="field"><div><span>Host</span><br><code id="cHost">–</code></div><button data-copy="cHost">Copy</button></div>
        <div class="field"><div><span>Port</span><br><code id="cPort">–</code></div><button data-copy="cPort">Copy</button></div>
        <div class="field"><div><span>Electrum server string</span><br><code id="cServer">–</code></div><button data-copy="cServer">Copy</button></div>
        <ol>
          <li>Start the wallet on the <b id="cNet">–</b> network.</li>
          <li><b>Sparrow:</b> Settings → Server → Private Electrum. Enter the host and port and leave SSL off.</li>
          <li><b>Electrum:</b> Tools → Network → Server. Turn off automatic server selection and enter the server string.</li>
          <li>The connection is plain TCP without TLS. Use it on your local network or over a VPN.</li>
        </ol>
      </section>

      <section class="card">
        <h3>Wallet requests</h3>
        <div id="rpc"><div class="empty">No wallet requests reported yet.</div></div>
      </section>
    </div>
  </div>

  <footer id="footer">Updates every 5 seconds</footer>
</main>

<script>
(function () {
  "use strict";

  var THEMES = {
    signet:   { bg1: "#241040", bg2: "#0a0612", accent: "#a855f7", soft: "#e9d5ff" },
    testnet3: { bg1: "#0a3321", bg2: "#040d09", accent: "#22c55e", soft: "#bbf7d0" },
    testnet4: { bg1: "#0d2552", bg2: "#050a16", accent: "#3b82f6", soft: "#bfdbfe" }
  };
  // Same geometry as the app icons (icon.svg), drawn as the Electrs variant.
  var MARKS = {
    signet: '<path d="M 232 700 H 512 A 200 200 0 1 0 511.9 700 H 792" fill="none" stroke="url(#m)" stroke-width="36" stroke-linecap="round"/>' +
            '<circle cx="512" cy="500" r="64" fill="url(#m)"/>',
    testnet3: '<rect x="228" y="324" width="408" height="88" rx="44" fill="none" stroke="url(#m)" stroke-width="32"/>' +
              '<rect x="308" y="468" width="408" height="88" rx="44" fill="none" stroke="url(#m)" stroke-width="32"/>' +
              '<rect x="388" y="612" width="408" height="88" rx="44" fill="none" stroke="url(#m)" stroke-width="32"/>' +
              '<circle cx="512" cy="512" r="46" fill="url(#m)" stroke="url(#b)" stroke-width="22"/>',
    testnet4: '<rect x="304" y="304" width="168" height="168" rx="32" fill="none" stroke="url(#m)" stroke-width="32"/>' +
              '<rect x="552" y="304" width="168" height="168" rx="32" fill="none" stroke="url(#m)" stroke-width="32"/>' +
              '<rect x="304" y="552" width="168" height="168" rx="32" fill="none" stroke="url(#m)" stroke-width="32"/>' +
              '<rect x="552" y="552" width="168" height="168" rx="32" fill="none" stroke="url(#m)" stroke-width="32"/>' +
              '<circle cx="512" cy="512" r="50" fill="url(#m)" stroke="url(#b)" stroke-width="26"/>'
  };

  var POLL_MS = 5000;
  var cfg = null;
  var samples = [];          // [{t, h}] index height over time, for speed/ETA
  var prev = null;           // previous snapshot, for the activity feed
  var feed = [];
  var lastBatchAt = 0, batchStart = null;

  function el(id) { return document.getElementById(id); }
  function fmtInt(n) { return n == null || isNaN(n) ? "–" : Math.round(n).toLocaleString(); }
  function fmtBytes(b) {
    if (b == null || isNaN(b)) return "–";
    var u = ["B", "KB", "MB", "GB", "TB"], i = 0;
    while (b >= 1000 && i < u.length - 1) { b /= 1000; i++; }
    return (b >= 100 || i === 0 ? b.toFixed(0) : b.toFixed(1)) + " " + u[i];
  }
  function fmtDuration(s) {
    if (s == null || !isFinite(s) || s < 0) return "–";
    if (s < 60) return Math.max(1, Math.round(s)) + " s";
    var m = Math.round(s / 60);
    if (m < 60) return m + " min";
    var h = Math.floor(m / 60);
    if (h < 48) return h + " h " + (m % 60) + " min";
    return Math.round(h / 24) + " days";
  }
  function clock(d) { return d.toTimeString().slice(0, 8); }

  function parseMetrics(text) {
    var out = {};
    text.split("\n").forEach(function (line) {
      if (!line || line.charAt(0) === "#") return;
      var m = line.match(/^([a-zA-Z_:][a-zA-Z0-9_:]*)(\{([^}]*)\})?\s+(\S+)/);
      if (!m) return;
      var labels = {};
      (m[3] || "").replace(/(\w+)="([^"]*)"/g, function (_, k, v) { labels[k] = v; });
      (out[m[1]] = out[m[1]] || []).push({ labels: labels, value: parseFloat(m[4]) });
    });
    return out;
  }
  function metric(ms, name, key, val) {
    var rows = ms[name] || [];
    for (var i = 0; i < rows.length; i++) if (key == null || rows[i].labels[key] === val) return rows[i].value;
    return null;
  }
  function dbProps(ms, prefix) {
    var total = null;
    (ms.electrs_index_db_properties || []).forEach(function (r) {
      if ((r.labels.name || "").indexOf(prefix) === 0) total = (total || 0) + r.value;
    });
    return total;
  }

  function getJSON(url) {
    return fetch(url, { cache: "no-store" }).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
  }
  function getText(url) {
    return fetch(url, { cache: "no-store" }).then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); });
  }
  function settle(p) { return p.then(function (v) { return { ok: true, v: v }; }, function () { return { ok: false }; }); }

  function addEvent(text) {
    feed.unshift({ t: new Date(), text: text });
    feed = feed.slice(0, 100);
    var ul = el("feed");
    ul.innerHTML = "";
    feed.forEach(function (e) {
      var li = document.createElement("li");
      var t = document.createElement("time");
      t.textContent = clock(e.t);
      var s = document.createElement("span");
      s.textContent = e.text;
      li.appendChild(t); li.appendChild(s); ul.appendChild(li);
    });
  }

  function rate() {
    // Blocks per second over roughly the last minute.
    if (samples.length < 2) return null;
    var last = samples[samples.length - 1], first = samples[0];
    for (var i = samples.length - 1; i >= 0; i--) { if (last.t - samples[i].t >= 60000) { first = samples[i]; break; } }
    var dt = (last.t - first.t) / 1000;
    return dt > 0 ? (last.h - first.h) / dt : null;
  }

  function drawSpark() {
    var svg = el("spark");
    var pts = [];
    for (var i = 1; i < samples.length; i++) {
      var dt = (samples[i].t - samples[i - 1].t) / 1000;
      pts.push(dt > 0 ? Math.max(0, (samples[i].h - samples[i - 1].h) / dt) : 0);
    }
    if (pts.length < 2) { svg.innerHTML = ""; return; }
    var max = Math.max.apply(null, pts) || 1, w = 300, h = 64, step = w / (pts.length - 1);
    var d = pts.map(function (v, i) { return (i ? "L" : "M") + (i * step).toFixed(1) + " " + (h - 4 - (v / max) * (h - 12)).toFixed(1); }).join(" ");
    svg.innerHTML =
      '<defs><linearGradient id="sf" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="' + THEMES[cfg.network].accent + '" stop-opacity="0.35"/>' +
      '<stop offset="1" stop-color="' + THEMES[cfg.network].accent + '" stop-opacity="0"/></linearGradient></defs>' +
      '<path d="' + d + " L " + w + " " + h + " L 0 " + h + ' Z" fill="url(#sf)"/>' +
      '<path d="' + d + '" fill="none" stroke="' + THEMES[cfg.network].soft + '" stroke-width="1.5" vector-effect="non-scaling-stroke"/>';
  }

  function setStatus(tone, pill, headline, detail, pct) {
    el("pill").className = "pill tone-" + tone;
    el("pillText").textContent = pill;
    el("headline").textContent = headline;
    el("detail").textContent = detail || "";
    var bar = el("bar");
    bar.style.visibility = pct == null ? "hidden" : "visible";
    if (pct != null) { bar.firstChild.style.width = (pct * 100).toFixed(2) + "%"; bar.setAttribute("aria-valuenow", (pct * 100).toFixed(1)); }
  }

  function tick() {
    Promise.all([settle(getText("api/metrics")), settle(getJSON("api/node/sync")), settle(getJSON("api/node/stats"))]).then(function (res) {
      var now = Date.now();
      var ms = res[0].ok ? parseMetrics(res[0].v) : null;
      var sync = res[1].ok ? res[1].v : null;
      var stats = res[2].ok ? res[2].v : null;
      var indexed = ms ? metric(ms, "electrs_index_height", "type", "tip") : null;
      var tip = sync ? sync.blockHeight : null;

      if (indexed != null) {
        samples.push({ t: now, h: indexed });
        while (samples.length > 40) samples.shift();
      }

      // Status
      var state, r = rate();
      var remaining = indexed != null && tip != null ? Math.max(0, tip - indexed) : null;
      if (!ms) {
        state = "down";
        setStatus("err", "Not responding", "Electrs isn't responding",
          "It may be starting up or restarting. If this lasts more than a few minutes, open the Electrs app's logs in umbrelOS.", null);
      } else if (!sync) {
        state = "nonode";
        setStatus("warn", "Node unreachable", "Can't reach " + cfg.bitcoinApp,
          "Electrs needs the " + cfg.bitcoinApp + " app installed and running.", null);
      } else if (sync.isInitialBlockDownload) {
        state = "nodesync";
        setStatus("busy", "Waiting for node", cfg.bitcoinApp + " is still syncing",
          "Electrs indexes blocks as the node validates them. Node sync: " + (sync.syncProgress * 100).toFixed(1) + "%.", sync.syncProgress);
      } else if (indexed == null) {
        state = "starting";
        setStatus("busy", "Starting", "Electrs is starting", "Opening the index database.", null);
      } else if (remaining > 1) {
        state = "indexing";
        setStatus("busy", "Indexing", "Indexing " + ((indexed / tip) * 100).toFixed(1) + "%",
          "Wallets can connect once the index reaches the node's latest block.", tip ? indexed / tip : null);
      } else {
        state = "ready";
        setStatus("ok", "Ready", "Ready for wallets", "The index is up to date with " + cfg.bitcoinApp + ".", 1);
      }

      el("rIndexed").textContent = fmtInt(indexed);
      el("rTip").textContent = fmtInt(tip);
      el("rRate").textContent = r == null ? "–" : (r >= 10 ? Math.round(r) : r.toFixed(1)) + " blocks/s";
      el("rEta").textContent = state === "ready" ? "0" : (r && remaining ? fmtDuration(remaining / r) : "–");

      // Stats
      if (ms) {
        el("sTx").textContent = fmtInt(metric(ms, "electrs_index_db_properties", "name", "rocksdb.estimate-num-keys:txid"));
        el("sDb").textContent = fmtBytes(dbProps(ms, "rocksdb.total-sst-files-size:"));
        el("sBlocks").textContent = fmtBytes(metric(ms, "electrs_p2p_recv_size_sum", "message", "block"));
        var nb = metric(ms, "electrs_p2p_recv_size_count", "message", "block");
        el("sBlocksN").textContent = nb == null ? "from the node" : fmtInt(nb) + " blocks since start";
      }
      if (stats) {
        el("sPeers").textContent = fmtInt(stats.peers);
        el("sMempool").textContent = "mempool " + fmtBytes(stats.mempoolBytes);
      }

      // Wallet requests: electrs reports these per method once wallets connect.
      var calls = [];
      if (ms) Object.keys(ms).forEach(function (name) {
        if (name.indexOf("electrum") === -1 || name.slice(-6) !== "_count") return;
        ms[name].forEach(function (row) { if (row.labels.method) calls.push([row.labels.method, row.value]); });
      });
      var rpcBox = el("rpc");
      if (calls.length) {
        calls.sort(function (a, b) { return b[1] - a[1]; });
        var table = document.createElement("table");
        calls.slice(0, 8).forEach(function (c) {
          var tr = table.insertRow();
          tr.insertCell().textContent = c[0];
          tr.insertCell().textContent = fmtInt(c[1]);
        });
        rpcBox.innerHTML = ""; rpcBox.appendChild(table);
      }
      var totalCalls = calls.reduce(function (s, c) { return s + c[1]; }, 0);

      // Activity feed: derived from what changed since the last poll.
      if (!prev) {
        addEvent(ms ? "Connected. Index at block " + fmtInt(indexed) + (tip != null ? " of " + fmtInt(tip) : "") + "."
                    : el("headline").textContent + ".");
      } else {
        if (prev.state !== state) {
          var msg = {
            down: "Electrs stopped responding.",
            nonode: "Lost contact with " + cfg.bitcoinApp + ".",
            nodesync: cfg.bitcoinApp + " is syncing. Electrs is waiting for it.",
            starting: "Electrs is starting.",
            indexing: prev.state === "ready" ? "Index fell behind the node. Catching up." : "Indexing started.",
            ready: "Index caught up with the node. Wallets can connect."
          }[state];
          if (prev.state === "down" && state !== "down") msg = "Electrs is responding again. " + msg;
          addEvent(msg);
        }
        if (state === "indexing" && indexed != null) {
          if (batchStart == null) { batchStart = { t: now, h: prev.indexed != null ? prev.indexed : indexed }; lastBatchAt = now; }
          if (now - lastBatchAt >= 30000 && indexed > batchStart.h) {
            addEvent("Indexed blocks " + fmtInt(batchStart.h + 1) + "–" + fmtInt(indexed) + " (" +
              fmtInt(indexed - batchStart.h) + " blocks in " + fmtDuration((now - batchStart.t) / 1000) + ").");
            batchStart = { t: now, h: indexed }; lastBatchAt = now;
          }
        } else {
          batchStart = null;
        }
        if (state === "ready" && prev.indexed != null && indexed > prev.indexed) {
          addEvent(indexed - prev.indexed === 1 ? "Indexed new block " + fmtInt(indexed) + "."
                                                : "Indexed blocks " + fmtInt(prev.indexed + 1) + "–" + fmtInt(indexed) + ".");
        }
        if (prev.totalCalls != null && totalCalls > prev.totalCalls) {
          var n = totalCalls - prev.totalCalls;
          addEvent("Answered " + fmtInt(n) + " wallet request" + (n === 1 ? "" : "s") + ".");
        }
      }
      prev = { state: state, indexed: indexed, totalCalls: calls.length ? totalCalls : null };

      drawSpark();
      el("footer").textContent = "Updates every 5 seconds · last update " + clock(new Date(now));
    }).then(function () { setTimeout(tick, POLL_MS); }, function () { setTimeout(tick, POLL_MS); });
  }

  function copy(text, btn) {
    function done() { var o = btn.textContent; btn.textContent = "Copied"; setTimeout(function () { btn.textContent = o; }, 1200); }
    if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(text).then(done); return; }
    // umbrelOS is usually served over plain http, where the clipboard API is unavailable.
    var ta = document.createElement("textarea");
    ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
    document.body.appendChild(ta); ta.select();
    try { document.execCommand("copy"); done(); } catch (e) {}
    document.body.removeChild(ta);
  }

  getJSON("config.json").then(function (c) {
    cfg = c;
    var t = THEMES[c.network] || THEMES.signet, root = document.documentElement.style;
    root.setProperty("--bg1", t.bg1); root.setProperty("--bg2", t.bg2);
    root.setProperty("--accent", t.accent); root.setProperty("--soft", t.soft);
    document.title = "Electrs " + c.label;
    el("title").textContent = "Electrs " + c.label;
    el("subtitle").textContent = "Personal Electrum server for " + c.bitcoinApp;
    el("mark").innerHTML =
      '<svg viewBox="0 0 1024 1024" aria-hidden="true"><defs>' +
      '<linearGradient id="b" x1="0" y1="0" x2="1024" y2="1024" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="' + t.bg1 + '"/><stop offset="1" stop-color="' + t.bg2 + '"/></linearGradient>' +
      '<linearGradient id="m" x1="232" y1="232" x2="792" y2="792" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="' + t.soft + '"/><stop offset="1" stop-color="' + t.accent + '"/></linearGradient>' +
      '</defs><rect width="1024" height="1024" fill="url(#b)"/>' + (MARKS[c.network] || "") + '</svg>';
    var host = window.location.hostname;
    el("cHost").textContent = host;
    el("cPort").textContent = c.port;
    el("cServer").textContent = host + ":" + c.port + ":t";
    el("cNet").textContent = c.label;
    Array.prototype.forEach.call(document.querySelectorAll("[data-copy]"), function (b) {
      b.addEventListener("click", function () { copy(el(b.getAttribute("data-copy")).textContent, b); });
    });
    tick();
  }, function () {
    setStatus("err", "Error", "Couldn't load this app's settings", "Reload the page. If it keeps happening, reinstall the Electrs app.", null);
  });
})();
</script>
</body>
</html>
